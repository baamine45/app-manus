# Copier ce fichier en .env et remplir les valeurs

# URL de connexion MongoDB Atlas
# Format : mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/app-menus?retryWrites=true&w=majority

# Port du serveur (Azure utilise la variable PORT automatiquement)
PORT=5000

# Environnement
NODE_ENV=production

# Origine CORS autorisée (URL de votre Azure Web App)
CORS_ORIGIN=https://votre-app.azurewebsites.net
